<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="web_layout_fonts" model="ir.ui.view">
        <field name="name">web.layout.fonts</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="web.layout"/>
        <field name="arch" type="xml">
            <xpath expr="//head" position="inside">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit account.payment Tree View -->
    <record id="view_account_payment_tree_inherit_star_travels" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.star.travels</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="x_gateway" widget="badge" optional="show"/>
                <field name="x_gateway_transaction_id" optional="show"/>
                <field name="x_reconciliation_state" widget="badge"
                       decoration-success="x_reconciliation_state == 'matched'"
                       decoration-danger="x_reconciliation_state == 'unmatched'"
                       decoration-warning="x_reconciliation_state == 'pending'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit account.payment Form View -->
    <record id="view_account_payment_form_inherit_star_travels" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.star.travels</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="x_gateway" readonly="state != 'draft'"/>
                <field name="x_gateway_transaction_id" readonly="state != 'draft'"/>
                <field name="x_reconciliation_state" widget="badge"
                       decoration-success="x_reconciliation_state == 'matched'"
                       decoration-danger="x_reconciliation_state == 'unmatched'"
                       decoration-warning="x_reconciliation_state == 'pending'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit account.payment Search View -->
    <record id="view_account_payment_search_inherit_star_travels" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.star.travels</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Chưa đối soát (Pending)" name="reconciliation_pending"
                        domain="[('x_reconciliation_state', '=', 'pending')]"/>
                <filter string="Đối soát khớp (Matched)" name="reconciliation_matched"
                        domain="[('x_reconciliation_state', '=', 'matched')]"/>
                <filter string="Đối soát lệch (Unmatched)" name="reconciliation_unmatched"
                        domain="[('x_reconciliation_state', '=', 'unmatched')]"/>
                <separator/>
                <filter string="Giao dịch Gateway (STAR)" name="gateway_payments"
                        domain="[('x_gateway', '!=', False)]"/>
                <separator/>
                <filter string="Cổng thanh toán (Gateway)" name="group_by_gateway"
                        context="{'group_by': 'x_gateway'}"/>
                <filter string="Trạng thái đối soát" name="group_by_reconciliation_state"
                        context="{'group_by': 'x_reconciliation_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>

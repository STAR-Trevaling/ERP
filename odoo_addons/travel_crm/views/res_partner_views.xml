<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Partner Form -->
    <record id="view_partner_form_inherit_travel" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.travel</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Star Travels Identity" name="travel_identity">
                    <group>
                        <group string="Public Platform Sync">
                            <field name="public_customer_id" readonly="1"/>
                            <field name="identity_provider" widget="badge"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Menu for Travelers / Customers -->
    <record id="action_travel_partners" model="ir.actions.act_window">
        <field name="name">Travelers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_customer': 1}</field>
    </record>

    <menuitem id="menu_travel_partners_travelers"
              name="Travelers"
              parent="travel_core.menu_travel_crm_root"
              action="action_travel_partners"
              sequence="20"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Article List -->
    <record id="view_travel_article_tree" model="ir.ui.view">
        <field name="name">travel.article.list</field>
        <field name="model">travel.article</field>
        <field name="arch" type="xml">
            <list string="Articles &amp; Stories" decoration-info="state == 'in_review'" decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="title"/>
                <field name="slug"/>
                <field name="destination_id"/>
                <field name="place_id"/>
                <field name="author_id"/>
                <field name="state" widget="badge" decoration-info="state == 'in_review'" decoration-success="state == 'published'" decoration-warning="state == 'draft'" decoration-muted="state == 'archived'"/>
                <field name="published_at"/>
            </list>
        </field>
    </record>

    <!-- Article Form -->
    <record id="view_travel_article_form" model="ir.ui.view">
        <field name="name">travel.article.form</field>
        <field name="model">travel.article</field>
        <field name="arch" type="xml">
            <form string="Editorial Article">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'in_review'" groups="travel_core.group_travel_manager"/>
                    <button name="action_publish" string="Publish to Website" type="object" class="btn-primary" invisible="state not in ('approved', 'published')" groups="travel_core.group_travel_manager"/>
                    <button name="action_request_changes" string="Request Changes" type="object" invisible="state != 'in_review'"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state == 'archived'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('archived', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1><field name="title" placeholder="e.g. 48 Hours in Da Nang: A Local Guide"/></h1>
                    </div>
                    <group>
                        <group string="Publishing Metadata">
                            <field name="slug"/>
                            <field name="public_id" readonly="1"/>
                            <field name="destination_id"/>
                            <field name="place_id"/>
                            <field name="author_id"/>
                        </group>
                        <group string="Lifecycle &amp; Media">
                            <field name="cover_image" placeholder="https://... cover image"/>
                            <field name="version"/>
                            <field name="published_at"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Article Content">
                            <group>
                                <field name="excerpt" placeholder="Short introductory teaser..."/>
                            </group>
                            <separator string="Body Content"/>
                            <field name="body" placeholder="Write your full editorial story here..."/>
                        </page>
                        <page string="Staff Internal Notes">
                            <field name="internal_notes" placeholder="Notes for review..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_travel_article" model="ir.actions.act_window">
        <field name="name">Articles &amp; Stories</field>
        <field name="res_model">travel.article</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_article"
              name="Stories &amp; Articles"
              parent="menu_travel_cms_root"
              action="action_travel_article"
              sequence="30"/>
</odoo>

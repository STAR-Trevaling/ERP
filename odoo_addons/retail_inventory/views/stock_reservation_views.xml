<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_retail_stock_reservation_tree" model="ir.ui.view">
        <field name="name">retail.stock.reservation.list</field>
        <field name="model">retail.stock.reservation</field>
        <field name="arch" type="xml">
            <list string="Giữ hàng Bán lẻ" decoration-info="state == 'active'" decoration-muted="state == 'released'" decoration-success="state == 'consumed'">
                <field name="name"/>
                <field name="order_reference"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"/>
                <field name="reserved_until"/>
                <field name="state" widget="badge" decoration-info="state == 'active'" decoration-muted="state == 'released'" decoration-success="state == 'consumed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_retail_stock_reservation_form" model="ir.ui.view">
        <field name="name">retail.stock.reservation.form</field>
        <field name="model">retail.stock.reservation</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Giữ hàng Bán lẻ">
                <header>
                    <button name="action_release" string="Giải phóng tồn kho" type="object" class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_consume" string="Chốt đơn xuất kho" type="object" class="btn-primary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,consumed,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="reservation_info" string="Thông tin đặt hàng">
                            <field name="order_reference" readonly="state != 'active'"/>
                            <field name="product_id" readonly="state != 'active'"/>
                            <field name="quantity" readonly="state != 'active'"/>
                        </group>
                        <group name="location_info" string="Kho và Thời hạn">
                            <field name="location_id" readonly="state != 'active'"/>
                            <field name="reserved_until" readonly="state != 'active'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_retail_stock_reservation_search" model="ir.ui.view">
        <field name="name">retail.stock.reservation.search</field>
        <field name="model">retail.stock.reservation</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Giữ hàng Bán lẻ">
                <field name="name"/>
                <field name="order_reference"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter name="filter_active" string="Đang giữ hàng (Active)" domain="[('state', '=', 'active')]"/>
                <filter name="filter_consumed" string="Đã chốt đơn" domain="[('state', '=', 'consumed')]"/>
                <filter name="filter_released" string="Đã giải phóng" domain="[('state', '=', 'released')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_location" string="Kho / Điểm bán" context="{'group_by': 'location_id'}"/>
                    <filter name="group_by_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    <filter name="group_by_product" string="Sản phẩm" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_retail_stock_reservation" model="ir.actions.act_window">
        <field name="name">Giữ hàng Bán lẻ (Reservations)</field>
        <field name="res_model">retail.stock.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có phiên giữ hàng nào.
            </p>
            <p>
                Hệ thống tự động khóa giữ tồn kho 15 phút khi khách hàng tiến hành checkout online hoặc đặt cọc tại quầy POS.
            </p>
        </field>
    </record>

    <!-- Menuitem under Inventory > Operations -->
    <menuitem id="menu_retail_stock_reservation"
              name="Giữ hàng Bán lẻ"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_retail_stock_reservation"
              sequence="25"/>
</odoo>

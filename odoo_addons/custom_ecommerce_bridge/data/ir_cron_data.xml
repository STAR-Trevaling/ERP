<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Quét và giải phóng tồn kho cho các đơn hàng Web hết hạn giữ chỗ -->
        <record id="ir_cron_release_expired_web_orders" model="ir.cron">
            <field name="name">E-commerce Bridge: Tự động giải phóng tồn kho đơn hàng hết hạn</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_release_expired_web_orders()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

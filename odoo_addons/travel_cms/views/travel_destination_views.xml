<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Destination Kanban -->
    <record id="view_travel_destination_kanban" model="ir.ui.view">
        <field name="name">travel.destination.kanban</field>
        <field name="model">travel.destination</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="country"/>
                <field name="state"/>
                <field name="image_url"/>
                <field name="place_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_image" t-if="record.image_url.raw_value">
                                <img t-att-src="record.image_url.raw_value" alt="Destination Image" style="width: 64px; height: 64px; object-fit: cover; border-radius: 4px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted"><field name="country"/></div>
                                <div><span class="badge rounded-pill text-bg-info"><t t-esc="record.place_count.raw_value"/> Places</span></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Destination List -->
    <record id="view_travel_destination_tree" model="ir.ui.view">
        <field name="name">travel.destination.list</field>
        <field name="model">travel.destination</field>
        <field name="arch" type="xml">
            <list string="Destinations" decoration-info="state == 'in_review'" decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="slug"/>
                <field name="country"/>
                <field name="starting_price" widget="monetary"/>
                <field name="place_count"/>
                <field name="state" widget="badge" decoration-info="state == 'in_review'" decoration-success="state == 'published'" decoration-warning="state == 'draft'" decoration-muted="state == 'archived'"/>
                <field name="version"/>
                <field name="published_at"/>
            </list>
        </field>
    </record>

    <!-- Destination Form -->
    <record id="view_travel_destination_form" model="ir.ui.view">
        <field name="name">travel.destination.form</field>
        <field name="model">travel.destination</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'in_review'" groups="travel_core.group_travel_manager"/>
                    <button name="action_publish" string="Publish to Website" type="object" class="btn-primary" invisible="state not in ('approved', 'published')" groups="travel_core.group_travel_manager"/>
                    <button name="action_request_changes" string="Request Changes" type="object" invisible="state != 'in_review'"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state == 'archived'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('archived', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(travel_core.action_travel_category)d" icon="fa-map-marker">
                            <field string="Places" name="place_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Da Nang, Ha Long Bay, Phu Quoc"/></h1>
                    </div>
                    <group>
                        <group string="Identity &amp; Location">
                            <field name="slug"/>
                            <field name="public_id" readonly="1"/>
                            <field name="country"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group string="Commercial &amp; Media">
                            <field name="starting_price"/>
                            <field name="image_url" placeholder="https://... card image"/>
                            <field name="hero_image_url" placeholder="https://... hero image"/>
                            <field name="version"/>
                            <field name="published_at"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Editorial Content">
                            <group>
                                <field name="summary" placeholder="Short highlight summary..."/>
                            </group>
                            <separator string="Full Editorial Article"/>
                            <field name="description" placeholder="Rich editorial description..."/>
                        </page>
                        <page string="Places &amp; Attractions">
                            <field name="place_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="average_rating"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Staff Internal Notes">
                            <field name="internal_notes" placeholder="Notes for reviewers and editors..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_travel_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">travel.destination</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and author your first Star Travels destination!
            </p>
        </field>
    </record>

    <menuitem id="menu_travel_destination"
              name="Destinations"
              parent="travel_core.menu_travel_cms_root"
              action="action_travel_destination"
              sequence="10"/>
</odoo>

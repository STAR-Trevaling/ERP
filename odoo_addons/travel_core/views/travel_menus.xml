<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Application Menu -->
    <menuitem id="menu_travel_root"
              name="Star Travels"
              web_icon="travel_core,static/description/icon.png"
              sequence="15"/>

    <!-- CRM Submenu -->
    <menuitem id="menu_travel_crm_root"
              name="CRM &amp; Inquiries"
              parent="menu_travel_root"
              sequence="10"/>

    <!-- CMS Submenu -->
    <menuitem id="menu_travel_cms_root"
              name="Content &amp; CMS"
              parent="menu_travel_root"
              sequence="20"/>

    <!-- Partners Submenu -->
    <menuitem id="menu_travel_partners_root"
              name="Partners"
              parent="menu_travel_root"
              sequence="30"/>

    <!-- Integration Submenu -->
    <menuitem id="menu_travel_integration_root"
              name="Integrations &amp; Logs"
              parent="menu_travel_root"
              groups="travel_core.group_travel_manager"
              sequence="40"/>

    <!-- Configuration Submenu -->
    <menuitem id="menu_travel_config_root"
              name="Configuration"
              parent="menu_travel_root"
              groups="travel_core.group_travel_manager"
              sequence="90"/>
</odoo>

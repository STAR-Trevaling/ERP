<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit CRM Lead Form -->
    <record id="crm_lead_view_form_inherit_travel" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']" position="after">
                <group string="Travel Inquiry Details" name="travel_inquiry_details">
                    <group>
                        <field name="source_system" widget="badge"/>
                        <field name="inquiry_type"/>
                        <field name="destination_interest_id"/>
                        <field name="place_interest_id"/>
                    </group>
                    <group>
                        <field name="travel_date_intended"/>
                        <field name="traveler_count"/>
                        <field name="public_customer_id" readonly="1"/>
                        <field name="external_lead_id" readonly="1"/>
                    </group>
                </group>
                <group string="Marketing &amp; Attribution" name="marketing_attribution">
                    <group string="UTM Campaign Tracking">
                        <field name="campaign_id"/>
                        <field name="source_id"/>
                        <field name="medium_id"/>
                        <field name="utm_term"/>
                        <field name="utm_content"/>
                    </group>
                    <group string="Conversion &amp; Click IDs">
                        <field name="gclid" readonly="1"/>
                        <field name="fbclid" readonly="1"/>
                        <field name="landing_page_url" widget="url" readonly="1"/>
                        <field name="referrer_url" widget="url" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit CRM Lead List View -->
    <record id="crm_case_tree_view_oppor_inherit_travel" model="ir.ui.view">
        <field name="name">crm.lead.list.inherit.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="source_system" widget="badge" optional="show"/>
                <field name="inquiry_type" optional="show"/>
                <field name="destination_interest_id" optional="show"/>
                <field name="campaign_id" optional="hide"/>
                <field name="source_id" optional="hide"/>
                <field name="medium_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit CRM Lead Kanban View -->
    <record id="crm_case_kanban_view_leads_inherit_travel" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <div class="mt-1" t-if="record.source_system.raw_value">
                    <span class="badge rounded-pill text-bg-primary">
                        <field name="source_system"/>
                    </span>
                    <span class="badge rounded-pill text-bg-info ms-1" t-if="record.destination_interest_id.raw_value">
                        <field name="destination_interest_id"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inherit CRM Filter / Search View -->
    <record id="view_crm_case_opportunities_filter_inherit_travel" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <separator/>
                <filter string="Travel Inquiries" name="travel_inquiries" domain="[('source_system', '!=', False)]"/>
                <filter string="From Website" name="from_website" domain="[('source_system', '=', 'website')]"/>
                <filter string="From Mobile App" name="from_mobile_app" domain="[('source_system', '=', 'mobile_app')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Source Channel" name="groupby_source_system" context="{'group_by': 'source_system'}"/>
                <filter string="Destination" name="groupby_destination" context="{'group_by': 'destination_interest_id'}"/>
                <filter string="Inquiry Type" name="groupby_inquiry_type" context="{'group_by': 'inquiry_type'}"/>
                <filter string="Campaign" name="groupby_campaign" context="{'group_by': 'campaign_id'}"/>
                <filter string="Medium" name="groupby_medium" context="{'group_by': 'medium_id'}"/>
                <filter string="Source" name="groupby_source" context="{'group_by': 'source_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>

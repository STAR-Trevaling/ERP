<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Retail Stock Reservation -->
        <record id="seq_retail_stock_reservation" model="ir.sequence">
            <field name="name">Retail Stock Reservation Sequence</field>
            <field name="code">retail.stock.reservation</field>
            <field name="prefix">RES/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron Job: Auto-release expired 15-min stock reservations -->
        <record id="ir_cron_release_expired_stock_reservations" model="ir.cron">
            <field name="name">Retail Inventory: Auto-Release Expired Stock Reservations</field>
            <field name="model_id" ref="model_retail_stock_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_release_expired_reservations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

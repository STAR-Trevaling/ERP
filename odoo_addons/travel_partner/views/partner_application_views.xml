<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Application Kanban -->
    <record id="view_travel_partner_app_kanban" model="ir.ui.view">
        <field name="name">travel.partner.application.kanban</field>
        <field name="model">travel.partner.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="business_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="business_name"/></strong>
                                <div class="text-muted"><field name="email"/></div>
                                <div class="text-muted"><field name="phone"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Application List -->
    <record id="view_travel_partner_app_tree" model="ir.ui.view">
        <field name="name">travel.partner.application.list</field>
        <field name="model">travel.partner.application</field>
        <field name="arch" type="xml">
            <list string="Partner Applications" decoration-info="state == 'under_review'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="business_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="website"/>
                <field name="state" widget="badge" decoration-info="state == 'under_review'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state == 'submitted'"/>
                <field name="reviewed_by_id"/>
                <field name="create_date" string="Applied Date"/>
            </list>
        </field>
    </record>

    <!-- Application Form -->
    <record id="view_travel_partner_app_form" model="ir.ui.view">
        <field name="name">travel.partner.application.form</field>
        <field name="model">travel.partner.application</field>
        <field name="arch" type="xml">
            <form string="Partner Application">
                <header>
                    <button name="action_start_review" string="Start Review" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve Partner" type="object" class="btn-success" invisible="state != 'under_review'" groups="travel_core.group_travel_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'under_review'" groups="travel_core.group_travel_manager"/>
                    <button name="action_reset_submitted" string="Reset to Submitted" type="object" invisible="state not in ('approved', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="business_name" class="oe_edit_only"/>
                        <h1><field name="business_name" placeholder="e.g. Ba Na Hills Eco Resort"/></h1>
                    </div>
                    <group>
                        <group string="Contact &amp; Web">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="website"/>
                            <field name="public_application_id" readonly="1"/>
                            <field name="applicant_id" readonly="1"/>
                        </group>
                        <group string="Review Outcome">
                            <field name="partner_id" readonly="1"/>
                            <field name="organization_slug" readonly="1"/>
                            <field name="reviewed_by_id"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <group string="Rejection Details" invisible="state != 'rejected'">
                        <field name="rejection_reason" placeholder="Explain reason for rejection..."/>
                    </group>
                    <notebook>
                        <page string="Applicant Statement">
                            <field name="message" placeholder="Application details and pitch..."/>
                        </page>
                        <page string="Staff Internal Verification Notes">
                            <field name="internal_notes" placeholder="Internal check (business license, legal verification, KYC)..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_travel_partner_application" model="ir.actions.act_window">
        <field name="name">Partner Applications</field>
        <field name="res_model">travel.partner.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                New partner onboarding applications submitted from the website will appear here for review!
            </p>
        </field>
    </record>

    <menuitem id="menu_travel_partner_apps"
              name="Partner Applications"
              parent="contacts.menu_contacts"
              action="action_travel_partner_application"
              sequence="5"/>
</odoo>

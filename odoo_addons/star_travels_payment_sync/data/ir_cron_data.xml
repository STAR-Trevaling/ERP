<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Cron to monitor unmatched gateway transactions -->
        <record id="ir_cron_check_unmatched_payments" model="ir.cron">
            <field name="name">STAR Travels: Check &amp; Alert Unmatched Gateway Payments</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_unmatched_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Hourly Cron to monitor stale pending VietQR transactions -->
        <record id="ir_cron_check_pending_vietqr" model="ir.cron">
            <field name="name">STAR Travels: Check &amp; Alert Stale Pending VietQR Payments</field>
            <field name="model_id" ref="model_star_travels_payment_pending"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_pending_vietqr()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
